#!/usr/bin/python3 -I
"""tailfiles — backend for the Tailnet Files Omarchy plugin.

Browses and moves files between this machine and the machines on your
tailnet over SSH: listings go through SFTP (works against Linux, macOS and
Windows OpenSSH alike), copies through a small fixed Perl helper on Linux
and macOS and through sftp on Windows. Every command prints JSON on stdout
so the QML side never has to parse human output.

  tailfiles peers
  tailfiles probe HOST
  tailfiles ls TARGET [PATH]
  tailfiles [--as HOST=USER]... COMMAND ...   (pins the SSH account per host)
  tailfiles copy [--replace] SRC_TARGET DST_TARGET DST_DIR PATH...   (streams JSON lines)
  tailfiles mkdir TARGET PATH
  tailfiles rename TARGET OLD NEW
  tailfiles delete TARGET PATH...
  tailfiles open TARGET PATH
  tailfiles config
  tailfiles set-user HOST [USER]
  tailfiles setup-key HOST

TARGET is "local" for this computer or an SSH host name from `peers`.
"""

import base64
import errno
import glob
import hashlib
import fcntl
import json
import os
import pty
import re
import select
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import termios
import time

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "tailfiles")
CONFIG_FILE = os.path.join(CONFIG_DIR, "hosts.json")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "tailfiles")
# Sockets and probe caches. Never a shared temp directory: without a
# per-user runtime dir, fall back to the private cache dir.
RUNTIME = (os.path.join(os.environ["XDG_RUNTIME_DIR"], "tailfiles")
           if os.environ.get("XDG_RUNTIME_DIR") else os.path.join(CACHE_DIR, "run"))
POSIX_SYSTEMS = {"Linux", "Darwin", "FreeBSD", "OpenBSD", "NetBSD", "DragonFly", "SunOS"}
HOST_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]*$")
USER_RE = re.compile(r"^[A-Za-z0-9._][A-Za-z0-9._@\\-]*$")
ENV = dict(os.environ, LC_ALL="C", LANG="C")


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


COPYING = False  # copy streams events, so its failures are "done" events
MUTED = False    # set while cleaning up after a copy has reported its result


def fail(message, kind="other", **extra):
    if not MUTED:
        obj = dict({"ok": False, "error": message, "kind": kind}, **extra)
        if COPYING:
            obj["event"] = "done"
        out(obj)
    sys.exit(1)


# ------------------------------------------------------------------ config

def load_config():
    try:
        with open(CONFIG_FILE) as fh:
            data = json.load(fh)
        if isinstance(data, dict) and isinstance(data.get("hosts"), dict):
            return data
    except (OSError, ValueError):
        pass
    return {"hosts": {}}


def save_config(data):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, CONFIG_FILE)


def host_user(host):
    entry = load_config()["hosts"].get(host) or {}
    user = entry.get("user") if isinstance(entry, dict) else None
    return user if isinstance(user, str) and USER_RE.match(user) else None


PINNED_USERS = {}  # host -> account given with --as for this run
_ACCOUNTS = {}      # host -> account resolved once for this run


def ssh_config_user(host):
    """The account plain `ssh HOST` would use (~/.ssh/config, else local)."""
    try:
        proc = subprocess.run(["ssh", "-G", host], capture_output=True, timeout=10, env=ENV,
                              stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    for line in decode_raw(proc.stdout).split("\n"):
        if line.startswith("user "):
            return line[5:]
    return ""


def account(host):
    """The SSH account for `host`, resolved once and then fixed for the whole
    run: from --as (what the window showed and the user confirmed), else the
    saved setting, else ssh's own config. Every ssh/sftp/scp child gets
    it explicitly, so changing the saved account mid-run can't switch
    accounts between a check and the action it guards."""
    if host not in _ACCOUNTS:
        user = PINNED_USERS.get(host) or host_user(host) or ssh_config_user(host)
        if not user or not USER_RE.match(user):
            fail("Can't tell which account to use on " + host)
        _ACCOUNTS[host] = user
    return _ACCOUNTS[host]


def probe_cache_path(host):
    tag = hashlib.sha256(account(host).encode("utf-8", "surrogateescape")).hexdigest()[:16]
    return os.path.join(RUNTIME, "probe-%s-%s.json" % (host, tag))


def forget_probe(host):
    for f in glob.glob(os.path.join(glob.escape(RUNTIME), "probe-%s*.json" % glob.escape(host))):
        try:
            os.remove(f)
        except OSError:
            pass


def check_host(host):
    if not host or not HOST_RE.match(host) or host.startswith("-"):
        fail("Invalid host name: %r" % host)
    return host


# --------------------------------------------------------------------- ssh

def ssh_opts(host, batch=True):
    os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
    opts = [
        "-o", "ConnectTimeout=8",
        "-o", "StrictHostKeyChecking=accept-new",
        "-o", "ControlMaster=auto",
        "-o", "ControlPath=" + os.path.join(RUNTIME, "cm-%C"),
        "-o", "ControlPersist=10m",
        "-o", "ServerAliveInterval=15",
        "-o", "LogLevel=ERROR",
    ]
    if batch:
        opts += ["-o", "BatchMode=yes"]
    opts += ["-o", "User=" + account(host)]
    return opts


def clean_stderr(text):
    lines = []
    for line in (text or "").splitlines():
        line = line.strip()
        if not line or line.startswith("**") or line.startswith("sftp>") or line.startswith("Connected to "):
            continue
        lines.append(line)
    return lines


def classify(stderr_lines):
    text = "\n".join(stderr_lines)
    if "Permission denied (" in text or "Too many authentication failures" in text:
        return "auth"
    if "Host key verification failed" in text or "IDENTIFICATION HAS CHANGED" in text:
        return "hostkey"
    for marker in ("Could not resolve hostname", "timed out", "No route to host",
                   "Connection refused", "Network is unreachable", "Connection closed",
                   "Connection reset", "kex_exchange_identification"):
        if marker in text:
            return "unreachable"
    if "No such file" in text or "not found" in text:
        return "notfound"
    if "Permission denied" in text:
        return "denied"
    return "other"


def error_text(stderr_lines, fallback):
    useful = [l for l in stderr_lines if l not in ("Connection closed", "Connection closed.")
              and not l.startswith("Connected to ")]
    for l in useful:
        if "Permission denied (" in l or "Could not resolve" in l or "timed out" in l:
            return l
    return useful[-1] if useful else (stderr_lines[-1] if stderr_lines else fallback)


CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")
SFTP_SPECIAL = set(" \t\"'\\#*?[")


def check_path(path):
    """Refuse paths no SSH tool can carry literally (a newline would start a
    new sftp batch command)."""
    if CONTROL_RE.search(path):
        fail("%r contains a control character, so it can't be handled safely" % path)
    return path


def sftp_quote(path):
    """One literal sftp batch operand, escaped the way sftp(1) documents:
    a backslash before whitespace, quotes, '#', backslash and the glob(3)
    characters. Unquoted, sftp reads this back as exactly `path` both for
    commands that glob their operand (rm, ls) and for those that don't
    (cd, mkdir, rename, rmdir). Quoting instead would rely on an
    undocumented special case."""
    check_path(path)
    if not path:
        fail("Empty path")
    if path.startswith("-"):
        path = "./" + path  # never read as an option
    return "".join("\\" + c if c in SFTP_SPECIAL else c for c in path)


def glob_escape(path):
    """Remote source paths for scp (SFTP mode) are glob patterns
    on the far side; escape them so they match only the file named."""
    check_path(path)
    return re.sub(r"([\\*?\[])", r"\\\1", path)


# Remote output is handled as exact bytes: no newline translation (text
# mode turns \r into \n) and no trimming, since spaces at either end and
# odd characters are valid in file and folder names. Undecodable bytes
# survive the round trip through surrogateescape.
def encode_raw(text):
    return text.encode("utf-8", "surrogateescape")


def decode_raw(data):
    return (data or b"").decode("utf-8", "surrogateescape")


def lines_of(text):
    """Split remote output on \\n only. str.splitlines() would also split
    on \\r, \\x1c-\\x1e, \\x85, U+2028 and U+2029, which can occur in names."""
    return text.split("\n")


PWD_PREFIX = "Remote working directory: "


ECHO = "sftp> "


def segment_ok(command, seg):
    """Does one command's output have exactly the shape that command produces?"""
    verb = command.lstrip("-").split(" ", 1)[0]
    if any(line.startswith(ECHO) for line in seg):
        return False  # a forged echo: some name or folder contains a line break
    if verb in ("cd", "mkdir", "rmdir", "rename"):
        return seg == []
    if verb == "pwd":
        return len(seg) == 1 and seg[0].startswith(PWD_PREFIX) and not CONTROL_RE.search(seg[0])
    return True


def sftp_segments(stdout, commands):
    """Split one batch's stdout into each command's output, or None.

    sftp echoes every command as "sftp> COMMAND" and prints `pwd` as one
    line. A folder or file name containing a line break makes extra lines,
    which can't fit this exact shape: cd prints nothing, pwd exactly one
    line, and no output line may look like an echo. So any such output is
    rejected instead of being read as a shorter path or a different name.
    If the batch stopped at a failing command, the segments end there."""
    lines = lines_of(stdout)
    if lines and lines[-1] == "":
        lines.pop()
    segs, i = [], 0
    for n, command in enumerate(commands):
        if i >= len(lines):
            break
        if lines[i] != ECHO + command:
            return None
        i += 1
        nxt = ECHO + commands[n + 1] if n + 1 < len(commands) else None
        start = i
        while i < len(lines) and lines[i] != nxt:
            i += 1
        seg = lines[start:i]
        if not segment_ok(command, seg):
            return None
        segs.append(seg)
    if i != len(lines):
        return None
    return segs


def pwd_value(seg):
    return seg[0][len(PWD_PREFIX):]


def sftp_batch(host, commands, timeout=60, what="that folder"):
    """Run a batch whose every command must succeed and whose output must have
    the exact expected shape; return the per-command outputs."""
    rc, stdout, err = run_sftp(host, commands, timeout)
    if rc != 0:
        fail(error_text(err, "Could not read " + what + " on " + host), classify(err))
    segs = sftp_segments(stdout, commands)
    if segs is None or len(segs) != len(commands):
        fail("The reply about %s on %s didn't have the expected shape (a name in it may contain "
             "a line break), so nothing was done" % (what, host))
    return segs


def run_sftp(host, commands, timeout=60):
    """Run sftp batch commands; return (rc, stdout, stderr_lines)."""
    # No -q: it would also silence ssh's own "Permission denied" diagnostics.
    cmd = ["sftp"] + ssh_opts(host) + ["-b", "-", host]
    try:
        proc = subprocess.run(cmd, input=encode_raw("\n".join(commands) + "\n"), capture_output=True,
                              timeout=timeout, env=ENV)
    except subprocess.TimeoutExpired:
        return 124, "", ["Timed out talking to " + host]
    return proc.returncode, decode_raw(proc.stdout), clean_stderr(proc.stderr.decode("utf-8", "replace"))


def run_ssh(host, remote_cmd, timeout=30, input_data=None):
    """remote_cmd goes through the remote login shell, so it must be a
    fixed string; pass anything user-controlled as input_data on stdin."""
    cmd = ["ssh"] + ssh_opts(host) + [host, remote_cmd]
    stdin = {"input": encode_raw(input_data)} if input_data is not None else {"stdin": subprocess.DEVNULL}
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=timeout, env=ENV, **stdin)
    except subprocess.TimeoutExpired:
        return 124, "", ["Timed out talking to " + host]
    return proc.returncode, decode_raw(proc.stdout), clean_stderr(proc.stderr.decode("utf-8", "replace"))


def sftp_home(host):
    """The folder an sftp session starts in (the account's home), or ""."""
    rc, stdout, _ = run_sftp(host, ["pwd"])
    segs = sftp_segments(stdout, ["pwd"]) if rc == 0 else None
    return pwd_value(segs[0]) if segs and len(segs) == 1 else ""


def probe(host, use_cache=True):
    path = probe_cache_path(host)
    if use_cache:
        try:
            if time.time() - os.path.getmtime(path) < 600:
                with open(path) as fh:
                    return json.load(fh)
        except (OSError, ValueError):
            pass
    rc, stdout, err = run_ssh(host, 'echo __TF__; uname -s; command -v rsync >/dev/null 2>&1 && echo rsync=yes || echo rsync=no; printf "%s\\0" "$HOME"')
    if rc == 255:
        kind = classify(err)
        return {"ok": False, "kind": kind, "error": error_text(err, "Could not connect to " + host)}
    lines = stdout.split("\n", 3)
    info = {"ok": True, "posix": False, "rsync": False, "system": "", "home": ""}
    if len(lines) == 4 and lines[0].strip() == "__TF__" and lines[1].strip() in POSIX_SYSTEMS:
        # $HOME is printed NUL-terminated, so it is taken exactly; one with a
        # control character is unusable and left empty (deletes then refuse).
        home, nul, _ = lines[3].partition("\0")
        if not nul or CONTROL_RE.search(home):
            home = ""
        info.update(posix=True, system=lines[1].strip(), rsync=lines[2].strip() == "rsync=yes", home=home)
    else:
        # Windows OpenSSH: no POSIX shell, but sftp starts in the profile
        # folder, e.g. /C:/Users/name.
        info["system"] = "Windows"
        info["home"] = sftp_home(host)
    try:
        os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
        with open(path, "w") as fh:
            json.dump(info, fh)
    except OSError:
        pass
    return info


# ----------------------------------------------------------------- listing

MONTHS = {m: i + 1 for i, m in enumerate("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split())}
LONG_RE = re.compile(r"^([-dlcbps][-rwxsStTl@+.]{9}\S*)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\d+)\s+"
                     r"([A-Z][a-z]{2})\s+(\d{1,2})\s+(\d{1,2}:\d{2}|\d{4})\s(.*)$")


def parse_mtime(mon, day, rest):
    now = time.localtime()
    month = MONTHS.get(mon, 1)
    try:
        if ":" in rest:
            hour, minute = (int(x) for x in rest.split(":"))
            year = now.tm_year
            t = time.mktime((year, month, int(day), hour, minute, 0, 0, 0, -1))
            if t > time.time() + 86400 * 2:
                t = time.mktime((year - 1, month, int(day), hour, minute, 0, 0, 0, -1))
            return int(t)
        return int(time.mktime((int(rest), month, int(day), 0, 0, 0, 0, 0, -1)))
    except (ValueError, OverflowError):
        return 0


def list_local(path):
    path = os.path.abspath(os.path.expanduser(path or HOME))
    if not os.path.isdir(path):
        fail("Not a folder: " + path, "notfound")
    entries = []
    try:
        it = os.scandir(path)
    except PermissionError:
        fail("Permission denied: " + path, "denied")
    except OSError as e:
        fail(str(e))
    with it:
        for e in it:
            try:
                lst = e.stat(follow_symlinks=False)
                is_link = stat.S_ISLNK(lst.st_mode)
                try:
                    st = e.stat() if is_link else lst
                except OSError:
                    st = lst
                kind = "dir" if stat.S_ISDIR(st.st_mode) else "file"
                entries.append({
                    "name": e.name, "type": kind, "link": is_link,
                    "size": st.st_size if kind == "file" else 0,
                    "mtime": int(st.st_mtime), "perm": stat.filemode(st.st_mode),
                })
            except OSError:
                continue
    return {"ok": True, "path": path, "entries": entries, "home": HOME}


def sftp_entries(ls_lines, names=None):
    """Parse the output lines of one sftp `ls -lan`.

    Nothing is trimmed. `ls -lan` is formatted by the sftp client, which never
    appends a link's target, so the text after the date is the whole name,
    even for a link literally called "a -> b". With `names` (the folder's
    exact names from another source) an entry is kept only if its name is
    one of them. A name that appears twice is always left out. Returns
    (entries, skipped)."""
    parsed = []
    skipped = 0
    for line in ls_lines:
        m = LONG_RE.match(line)
        if not m:
            continue
        perm, size, mon, day, rest, name = m.group(1), int(m.group(5)), m.group(6), m.group(7), m.group(8), m.group(9)
        if name in (".", ".."):
            continue
        if names is not None and name not in names:
            skipped += 1
            continue
        kind = {"d": "dir", "l": "link"}.get(perm[0], "file")
        parsed.append({"name": name, "type": kind, "link": kind == "link", "target": "",
                       "size": size if kind == "file" else 0,
                       "mtime": parse_mtime(mon, day, rest), "perm": perm})
    counts = {}
    for e in parsed:
        counts[e["name"]] = counts.get(e["name"], 0) + 1
    entries = [e for e in parsed if counts[e["name"]] == 1]
    skipped += len(parsed) - len(entries)
    return entries, skipped


# Exact names in a folder on a POSIX machine, NUL-separated. The command is
# fixed; the folder arrives on stdin.
NAMES_CMD = "sh -c 'IFS= read -r d && cd -- \"$d\" && exec find . -mindepth 1 -maxdepth 1 -print0'"


def exact_names(host, folder):
    check_path(folder)
    rc, stdout, err = run_ssh(host, NAMES_CMD, input_data=folder + "\n")
    if rc != 0:
        fail(error_text(err, "Couldn't read the exact names in " + folder), classify(err))
    return {n[2:] if n.startswith("./") else n for n in stdout.split("\0") if n}


def basename_of(path):
    return path.rstrip("/").rpartition("/")[2]


# Whether exact paths exist on a POSIX machine, as the filesystem itself
# looks them up (so on a case-insensitive volume a name that differs only in
# case counts). Prints one 0 or 1 per path, in order; the paths arrive
# NUL-separated on stdin. A dangling symlink counts as existing.
EXISTS_CMD = ("xargs -0 sh -c 'for p do if [ -e \"$p\" ] || [ -L \"$p\" ]; "
              "then printf 1; else printf 0; fi; done' sh")


def existing_names(target, folder, wanted):
    """Which of `wanted` (plain names) already exist in `folder`."""
    if target == "local":
        return [n for n in wanted if os.path.lexists(os.path.join(folder, n))]
    host = check_host(target)
    if not wanted:
        return []
    if probe(host).get("posix"):
        check_path(folder)
        rc, stdout, err = run_ssh(host, EXISTS_CMD, input_data="".join(join_remote(folder, n) + "\0" for n in wanted))
        if rc != 0 or len(stdout) != len(wanted) or set(stdout) - {"0", "1"}:
            fail(error_text(err, "Couldn't check what already exists in " + folder), classify(err))
        return [n for n, c in zip(wanted, stdout) if c == "1"]
    # No shell: ask sftp about each exact path. `ls` of something that exists
    # prints at least one line (a folder lists . and ..); of nothing, none.
    cmds = ["-ls -lan " + sftp_quote(join_remote(folder, n)) for n in wanted]
    rc, stdout, err = run_sftp(host, cmds)
    segs = sftp_segments(stdout, cmds) if rc == 0 else None
    if segs is None or len(segs) != len(cmds):
        fail(error_text(err, "Couldn't check what already exists in " + folder), classify(err))
    return [n for n, seg in zip(wanted, segs) if seg]


def list_remote(host, path):
    cmds = (["cd " + sftp_quote(path)] if path else []) + ["pwd", "ls -lan"]
    segs = sftp_batch(host, cmds, what=path or "the home folder")
    pwd, ls_lines = pwd_value(segs[-2]), segs[-1]
    # sftp's listing is text, so a name with a line break in it could read
    # as a different name. On POSIX machines, check every name against the
    # folder's exact names; Windows names can't contain line breaks.
    names = exact_names(host, pwd) if probe(host).get("posix") else None
    entries, skipped = sftp_entries(ls_lines, names)
    # Links whose target is a folder should open like folders. Ask the server
    # in one round trip which of them `cd` into: each check prints one
    # working directory, unchanged when the cd failed.
    links = [e for e in entries if e["type"] == "link"][:200]
    if links:
        checks = ["cd " + sftp_quote(pwd)]
        for e in links:
            checks += ["-cd " + sftp_quote(join_remote(pwd, e["name"])), "pwd", "cd " + sftp_quote(pwd)]
        rc, so2, _ = run_sftp(host, checks)
        segs2 = sftp_segments(so2, checks) if rc == 0 else None
        if segs2 is not None and len(segs2) == len(checks):
            seen = [pwd_value(segs2[2 + 3 * k]) for k in range(len(links))]
        else:
            seen = [pwd] * len(links)  # can't tell reliably: show them as files
        for k, e in enumerate(links):
            e["type"] = "dir" if seen[k] != pwd else "file"
    for e in entries:
        if e["type"] == "link":
            e["type"] = "file"
    return {"ok": True, "path": pwd, "entries": entries, "skipped": skipped, "user": account(host)}


def join_remote(base, name):
    if not base:
        return name
    return base.rstrip("/") + "/" + name if base != "/" else "/" + name


# --------------------------------------------------------------- transfers
#
# A copy is a stream of records read from the source, written into a new
# private folder at the destination, and then moved into place:
#   D path mode mtime        a folder (always before anything inside it)
#   F path mode mtime size   a regular file, followed by exactly size bytes
#   L path target            a symlink, copied as a symlink, never followed
#   S                        something skipped (socket, device, pipe)
# Fields end in NUL. Paths are relative ("name/sub/file") and start with one
# of the selected names.
#
# Readers here and on Linux/macOS hold each folder open while reading it,
# open every file with O_NOFOLLOW and check it is the object they examined,
# so nothing swapped in by a pathname during the copy is ever read.
# Writers create everything exclusively inside a folder only this copy
# uses, again holding each folder open. Placement then moves each item out
# of that folder with a rename that refuses to replace anything
# (renameat2 RENAME_NOREPLACE on Linux, renameatx_np RENAME_EXCL on macOS),
# relative to folders it holds open. With Replace, files and links replace
# files and links with one atomic rename, and folders merge only into real
# folders that are held open while their contents move in. Where that
# can't be done atomically, the item is left out and the copy fails.
#
# On Linux and macOS machines the remote half is a small fixed Perl
# program (below) sent on stdin; paths travel as data, never through a
# shell. Windows has no such way, see windows_home_only().

SCP_RE = re.compile(r"^(.*?)\s+(\d{1,3})%\s+(\S+)\s+(\S+/s)")
CHILDREN = []  # processes a cancel must stop


def kill_child(*_):
    for p in CHILDREN:
        if p.poll() is None:
            try:
                os.killpg(p.pid, signal.SIGTERM)
            except OSError:
                pass
    for p in CHILDREN:
        try:
            p.wait(timeout=3)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass
    if not MUTED:
        out({"event": "done", "ok": False, "cancelled": True, "error": "Cancelled"})
    sys.exit(130)


def stream(cmd, parse):
    """Run sftp under a pty so it draws its progress meter, emitting progress
    events. Returns (rc, stderr_lines)."""
    master, slave = pty.openpty()

    # The meter is drawn only when the pty is the controlling terminal and
    # sftp is the foreground process group there.
    def own_tty():
        os.setsid()
        fcntl.ioctl(slave, termios.TIOCSCTTY, 0)

    child = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=slave, stderr=subprocess.PIPE,
                             env=ENV, preexec_fn=own_tty)
    CHILDREN.append(child)
    os.close(slave)
    source = master
    errfd = child.stderr.fileno()
    open_fds = {source, errfd}
    buf = b""
    errbuf = b""
    last_emit = 0.0
    while open_fds:
        ready, _, _ = select.select(list(open_fds), [], [], 0.5)
        for fd in ready:
            try:
                chunk = os.read(fd, 65536)
            except OSError:
                chunk = b""
            if not chunk:
                open_fds.discard(fd)
                continue
            if fd == errfd:
                errbuf += chunk
                continue
            buf += chunk
            parts = re.split(rb"[\r\n]", buf)
            buf = parts.pop()
            for raw in parts:
                event = parse(raw.decode("utf-8", "replace"))
                now = time.time()
                if event and (now - last_emit > 0.25 or event.get("pct") == 100):
                    last_emit = now
                    out(dict({"event": "progress"}, **event))
    child.wait()
    os.close(master)
    return child.returncode, clean_stderr(errbuf.decode("utf-8", "replace"))


def parse_scp(line):
    m = SCP_RE.search(line.strip())
    if not m:
        return None
    return {"pct": int(m.group(2)), "file": os.path.basename(m.group(1).strip()), "rate": m.group(4)}


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return ("%.0f%s" if unit == "B" else "%.1f%s") % (n, unit)
        n /= 1024.0
    return "%.1fTB" % n


class Progress:
    def __init__(self):
        self.total = 0
        self.done = 0
        self.start = time.time()
        self.last = 0.0
        self.file = ""

    def add(self, n, name=None):
        self.done += n
        if name:
            self.file = name
        now = time.time()
        if now - self.last > 0.25:
            self.last = now
            pct = min(99, int(100 * self.done / self.total)) if self.total else 0
            out({"event": "progress", "pct": pct, "file": self.file,
                 "rate": human(self.done / max(now - self.start, 0.001)) + "/s"})


# ------------------------------------------------------- this computer, bound

O_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
NOREPLACE = 1
_RENAMEAT2 = []


def renameat2(sfd, s, dfd, d, flags):
    """rename relative to two open folders. Raises OSError (ENOSYS where the
    call is missing, EINVAL where the filesystem can't honor the flag)."""
    if not _RENAMEAT2:
        try:
            import ctypes
            fn = ctypes.CDLL(None, use_errno=True).renameat2
            fn.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
            _RENAMEAT2.append((fn, ctypes))
        except (OSError, AttributeError):
            _RENAMEAT2.append(None)
    if _RENAMEAT2[0] is None:
        raise OSError(errno.ENOSYS, "renameat2 is not available", d)
    fn, ctypes = _RENAMEAT2[0]
    if fn(sfd, os.fsencode(s), dfd, os.fsencode(d), flags) != 0:
        e = ctypes.get_errno()
        raise OSError(e, os.strerror(e), d)


def can_not_be_atomic(e):
    return e.errno in (errno.EINVAL, errno.ENOSYS, errno.EOPNOTSUPP)


def open_top(path):
    try:
        return os.open(path, O_DIR)
    except OSError as e:
        fail("Can't open %s (%s)" % (path, e.strerror), "denied" if e.errno == errno.EACCES else "notfound")


def open_dir_at(pfd, name):
    """fd of folder `name` in the folder `pfd` holds, but only if it is a
    real folder and the very one that was examined; otherwise None."""
    try:
        st = os.stat(name, dir_fd=pfd, follow_symlinks=False)
        if not stat.S_ISDIR(st.st_mode):
            return None
        fd = os.open(name, O_DIR | os.O_NOFOLLOW, dir_fd=pfd)
    except OSError:
        return None
    fst = os.fstat(fd)
    if (fst.st_dev, fst.st_ino) != (st.st_dev, st.st_ino):
        os.close(fd)
        return None
    return fd


def local_size(pfd, name):
    try:
        st = os.stat(name, dir_fd=pfd, follow_symlinks=False)
    except OSError:
        return 0
    if stat.S_ISREG(st.st_mode):
        return st.st_size
    total = 0
    if stat.S_ISDIR(st.st_mode):
        fd = open_dir_at(pfd, name)
        if fd is not None:
            try:
                for n in os.listdir(fd):
                    total += local_size(fd, n)
            finally:
                os.close(fd)
    return total


def fd_chunks(fd, size, rel):
    left = size
    while left > 0:
        data = os.read(fd, min(left, 262144))
        if not data:
            fail("%s got shorter while it was being copied" % rel)
        left -= len(data)
        yield data


def local_walk(pfd, name, rel):
    try:
        st = os.stat(name, dir_fd=pfd, follow_symlinks=False)
    except OSError:
        fail("%s disappeared while it was being copied" % rel)
    mode = st.st_mode
    if stat.S_ISLNK(mode):
        yield ("L", rel, os.readlink(name, dir_fd=pfd))
    elif stat.S_ISDIR(mode):
        fd = open_dir_at(pfd, name)
        if fd is None:
            fail("%s changed while it was being copied" % rel)
        try:
            yield ("D", rel, stat.S_IMODE(mode), int(st.st_mtime))
            for k in sorted(os.listdir(fd)):
                if CONTROL_RE.search(k):
                    yield ("S",)
                else:
                    yield from local_walk(fd, k, rel + "/" + k)
        finally:
            os.close(fd)
    elif stat.S_ISREG(mode):
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=pfd)
        except OSError:
            fail("%s changed while it was being copied" % rel)
        try:
            fst = os.fstat(fd)
            if not stat.S_ISREG(fst.st_mode) or (fst.st_dev, fst.st_ino) != (st.st_dev, st.st_ino):
                fail("%s changed while it was being copied" % rel)
            yield ("F", rel, stat.S_IMODE(fst.st_mode), int(fst.st_mtime), fst.st_size,
                   fd_chunks(fd, fst.st_size, rel))
        finally:
            os.close(fd)
    else:
        yield ("S",)


def local_records(parent, names, prog):
    pfd = open_top(parent)
    try:
        prog.total = sum(local_size(pfd, n) for n in names)
        for n in names:
            yield from local_walk(pfd, n, n)
    finally:
        os.close(pfd)


class LocalSink:
    """Writes records into the new folder `stage` inside the folder `dfd`."""

    def __init__(self, dfd, stage):
        self.sfd = open_dir_at(dfd, stage)
        if self.sfd is None:
            fail("The copy's new folder changed before anything was written")
        self.stack = [("", self.sfd)]
        self.fix = []

    def parent(self, p):
        par, _, name = p.rpartition("/")
        while len(self.stack) > 1 and self.stack[-1][0] != par:
            os.close(self.stack.pop()[1])
        if self.stack[-1][0] != par or name in ("", ".", ".."):
            fail("Unexpected item in the copy: %r" % p)
        return self.stack[-1][1], name

    def write(self, rec, prog):
        kind, p = rec[0], rec[1]
        pfd, name = self.parent(p)
        try:
            if kind == "D":
                os.mkdir(name, 0o700, dir_fd=pfd)
                fd = open_dir_at(pfd, name)
                if fd is None:
                    fail("%s changed while it was being written" % p)
                self.stack.append((p, fd))
                self.fix.append((p, rec[2], rec[3]))
            elif kind == "F":
                fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600,
                             dir_fd=pfd)
                try:
                    for chunk in rec[5]:
                        view = memoryview(chunk)
                        while view:
                            view = view[os.write(fd, view):]
                        prog.add(len(chunk), name)
                    os.fchmod(fd, rec[2] & 0o777)
                    os.utime(fd, (rec[3], rec[3]))
                finally:
                    os.close(fd)
            elif kind == "L":
                os.symlink(rec[2], name, dir_fd=pfd)
        except OSError as e:
            fail("Couldn't write %s (%s)" % (p, e.strerror))

    def close(self):
        while len(self.stack) > 1:
            os.close(self.stack.pop()[1])
        for p, mode, mtime in reversed(self.fix):
            fd, ok = self.sfd, True
            for part in p.split("/"):
                nfd = open_dir_at(fd, part)
                if fd != self.sfd:
                    os.close(fd)
                if nfd is None:
                    ok = False
                    break
                fd = nfd
            if ok:
                os.fchmod(fd, (mode & 0o777) | 0o700)
                os.utime(fd, (mtime, mtime))
                os.close(fd)


def place_local(sfd, dfd, rel, replace, conflicts, errors):
    """Move everything in the folder sfd holds into the folder dfd holds."""
    for n in sorted(os.listdir(sfd)):
        r = rel + "/" + n if rel else n
        try:
            mine = os.stat(n, dir_fd=sfd, follow_symlinks=False).st_mode
        except OSError:
            continue
        try:
            renameat2(sfd, n, dfd, n, NOREPLACE)
            continue
        except OSError as e:
            if can_not_be_atomic(e) or e.errno != errno.EEXIST:
                errors.append((r, e.strerror))
                continue
        if not replace:
            conflicts.append(r)
            continue
        try:
            theirs = os.stat(n, dir_fd=dfd, follow_symlinks=False).st_mode
        except OSError:
            conflicts.append(r)
            continue
        if stat.S_ISDIR(mine) and stat.S_ISDIR(theirs):
            cs, cd = open_dir_at(sfd, n), open_dir_at(dfd, n)
            if cs is None or cd is None:
                conflicts.append(r)
            else:
                place_local(cs, cd, r, True, conflicts, errors)
            for fd in (cs, cd):
                if fd is not None:
                    os.close(fd)
        elif not stat.S_ISDIR(mine) and not stat.S_ISDIR(theirs):
            try:
                renameat2(sfd, n, dfd, n, 0)  # replaces the file or the link itself, atomically
            except OSError:
                conflicts.append(r)
        else:
            conflicts.append(r)


# ------------------------------------------------- Linux and macOS, bound

AGENT_PL = r'''
use strict; use warnings;
use Fcntl qw(O_RDONLY O_WRONLY O_CREAT O_EXCL O_NOFOLLOW O_NONBLOCK :mode);
use Errno qw(EEXIST ENOENT EINVAL ENOSYS);
use POSIX ();
use Config;
binmode STDIN; binmode STDOUT;
$SIG{PIPE} = 'DEFAULT';

# A receive that doesn't finish removes the folder it made (relative to the
# destination folder it holds open; rm never follows a symlink).
my $UNDO;
sub bail { print STDERR $_[0], "\n"; if ($UNDO) { chdir($UNDO->[0]) and system("rm", "-rf", "--", "./$UNDO->[1]") } exit($_[1] || 1) }
$SIG{HUP} = $SIG{TERM} = sub { bail("stopped", 130) };
sub field { local $/ = "\0"; my $f = <STDIN>; defined $f && chop($f) eq "\0" or bail("short input", 2); $f }
sub rec { print @_ }

# rename relative to two open folders; $excl refuses to replace anything.
my $NR;
if ($^O eq 'linux') {
    my $a = $Config{archname};
    $NR = $a =~ /^x86_64/ ? 316 : $a =~ /^(aarch64|riscv64|loongarch64)/ ? 276 : $a =~ /^arm/ ? 382
        : $a =~ /^i[3-6]86/ ? 353 : $a =~ /^(ppc64|powerpc64)/ ? 357 : $a =~ /^s390x/ ? 347 : undef;
}
sub rename_at {
    my ($sfd, $s, $dfd, $d, $excl) = @_;
    my $r;
    if ($^O eq 'darwin') { $r = syscall(488, $sfd + 0, "$s", $dfd + 0, "$d", $excl ? 4 : 0) }
    elsif (defined $NR) { $r = syscall($NR, $sfd + 0, "$s", $dfd + 0, "$d", $excl ? 1 : 0) }
    else { $! = ENOSYS; return 0 }
    return $r == 0;
}
sub unsafe_fs { my $e = $! + 0; $e == EINVAL || $e == ENOSYS }

sub fd_of { my $fd = fileno($_[0]); defined $fd or bail("perl here is too old (needs 5.22 or newer)", 9); $fd }

# Open folder $name inside the folder held by $ph, only if it is a real
# folder and the one that was checked (same device and inode).
sub open_dir_at {
    my ($ph, $name) = @_;
    chdir($ph) or return;
    my @l = lstat($name) or return;
    S_ISDIR($l[2]) or return;
    opendir(my $h, $name) or return;
    my @s = stat($h) or return;
    ($s[0] == $l[0] && $s[1] == $l[1]) or return;
    return $h;
}
sub names_in { my $h = shift; rewinddir($h); sort grep { $_ ne '.' && $_ ne '..' } readdir($h) }
sub open_top { my $p = shift; opendir(my $h, $p) or bail("Can't open $p: $!", 3); fd_of($h); $h }

# ---- send: stream the selected items, never following a symlink.
sub size_at {
    my ($ph, $name) = @_;
    chdir($ph) or return 0;
    my @l = lstat($name) or return 0;
    return $l[7] if S_ISREG($l[2]);
    return 0 unless S_ISDIR($l[2]);
    my $h = open_dir_at($ph, $name) or return 0;
    my $t = 0; $t += size_at($h, $_) for names_in($h);
    return $t;
}
sub send_at {
    my ($ph, $name, $rel) = @_;
    chdir($ph) or bail("lost the folder of $rel", 6);
    my @l = lstat($name);
    if (!@l) { bail("$rel disappeared while copying", 6) }
    if (S_ISLNK($l[2])) {
        my $t = readlink($name);
        defined $t ? rec("L", "$rel\0$t\0") : rec("S");
    } elsif (S_ISDIR($l[2])) {
        my $h = open_dir_at($ph, $name) or bail("$rel changed while copying", 6);
        rec("D", "$rel\0", ($l[2] & 07777), "\0$l[9]\0");
        for my $k (names_in($h)) {
            if ($k =~ /[\x00-\x1f\x7f]/) { rec("S"); next }
            send_at($h, $k, "$rel/$k");
        }
        closedir($h);
    } elsif (S_ISREG($l[2])) {
        chdir($ph);
        sysopen(my $f, $name, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or bail("$rel changed while copying ($!)", 6);
        my @s = stat($f);
        (@s && S_ISREG($s[2]) && $s[0] == $l[0] && $s[1] == $l[1]) or bail("$rel changed while copying", 6);
        my $left = $s[7];
        rec("F", "$rel\0", ($s[2] & 07777), "\0$s[9]\0$left\0");
        while ($left > 0) {
            my $n = sysread($f, my $buf, $left < 262144 ? $left : 262144);
            defined $n && $n > 0 or bail("$rel got shorter while copying", 6);
            print $buf; $left -= $n;
        }
        close($f);
    } else {
        rec("S");
    }
}
sub cmd_send {
    my $parent = field(); my $count = field();
    my @names = map { field() } 1 .. $count;
    my $P = open_top($parent);
    my $total = 0; $total += size_at($P, $_) for @names;
    rec("T", "$total\0");
    send_at($P, $_, $_) for @names;
    rec("Z");
}

# ---- recv: write a stream into a new private folder inside $dst.
sub cmd_recv {
    my $dst = field(); my $stage = field();
    my $D = open_top($dst);
    chdir($D) or bail("Can't enter $dst", 3);
    umask(077);
    mkdir($stage, 0700) or bail("Can't write to $dst ($!)", 3);
    $UNDO = [$D, $stage];
    my $S = open_dir_at($D, $stage) or bail("The new folder in $dst changed", 6);
    my @stack = (["", $S]); my @fix;
    while (1) {
        my $t; read(STDIN, $t, 1) == 1 or bail("short input", 2);
        last if $t eq "Z";
        my $p = field();
        my ($par, $name) = $p =~ m{^(?:(.*)/)?([^/]+)$} or bail("bad name", 2);
        $par = "" unless defined $par;
        ($name ne '.' && $name ne '..') or bail("bad name", 2);
        pop(@stack) while @stack > 1 && $stack[-1][0] ne $par;
        $stack[-1][0] eq $par or bail("out of order: $p", 2);
        my $ph = $stack[-1][1];
        chdir($ph) or bail("lost a folder", 6);
        if ($t eq "D") {
            my $mode = field(); my $mt = field();
            mkdir($name, 0700) or bail("Can't create $p ($!)", 1);
            my $h = open_dir_at($ph, $name) or bail("$p changed", 6);
            push @stack, [$p, $h]; push @fix, [$ph, $name, $mode, $mt];
        } elsif ($t eq "F") {
            my $mode = field(); my $mt = field(); my $left = field();
            sysopen(my $f, $name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) or bail("Can't create $p ($!)", 1);
            while ($left > 0) {
                my $n = read(STDIN, my $buf, $left < 262144 ? $left : 262144);
                defined $n && $n > 0 or bail("short input", 2);
                defined syswrite($f, $buf) or bail("Can't write $p ($!)", 1);
                $left -= $n;
            }
            chmod($mode & 0777, $f); utime($mt, $mt, $f);
            close($f) or bail("Can't write $p ($!)", 1);
        } elsif ($t eq "L") {
            my $target = field();
            symlink($target, $name) or bail("Can't create $p ($!)", 1);
        } else {
            bail("bad record", 2);
        }
    }
    for my $x (reverse @fix) {
        chdir($x->[0]) or next;
        chmod(($x->[2] & 0777) | 0700, $x->[1]); utime($x->[3], $x->[3], $x->[1]);
    }
    $UNDO = undef;
    print "ok\0";
}

# ---- place: move the stage's items into $dst. Without replace, an atomic
# rename that refuses to replace anything; with replace, files and links
# replace files and links atomically and folders merge into real folders.
sub place_in {
    my ($sh, $dh, $rel, $replace) = @_;
    for my $n (names_in($sh)) {
        my $r = $rel eq "" ? $n : "$rel/$n";
        chdir($sh) or bail("lost a folder", 6);
        my @m = lstat($n) or next;
        next if rename_at(fd_of($sh), $n, fd_of($dh), $n, 1);
        if (unsafe_fs()) { rec("E", "$r\0"); next }
        if ($! + 0 != EEXIST) { rec("E", "$r\0"); next }
        if (!$replace) { rec("C", "$r\0"); next }
        chdir($dh) or bail("lost a folder", 6);
        my @t = lstat($n) or do { rec("C", "$r\0"); next };
        if (S_ISDIR($m[2]) && S_ISDIR($t[2])) {
            my $cs = open_dir_at($sh, $n) or do { rec("E", "$r\0"); next };
            my $cd = open_dir_at($dh, $n) or do { rec("C", "$r\0"); next };
            place_in($cs, $cd, $r, 1);
            closedir($cs); closedir($cd);
        } elsif (!S_ISDIR($m[2]) && !S_ISDIR($t[2])) {
            rename_at(fd_of($sh), $n, fd_of($dh), $n, 0) or rec("C", "$r\0");
        } else {
            rec("C", "$r\0");
        }
    }
}
sub cmd_place {
    my $dst = field(); my $stage = field(); my $mode = field();
    my $D = open_top($dst);
    my $S = open_dir_at($D, $stage) or bail("The copy's folder in $dst changed", 6);
    place_in($S, $D, "", $mode eq "replace");
    rec("Z");
}

# ---- rename one item inside a folder without replacing anything.
sub cmd_rename {
    my $dir = field(); my $old = field(); my $new = field();
    my $D = open_top($dir);
    exit 0 if rename_at(fd_of($D), $old, fd_of($D), $new, 1);
    bail("exists", 17) if $! + 0 == EEXIST;
    bail("unsafe", 22) if unsafe_fs();
    bail("$!", 1);
}

my $cmd = field();
if ($cmd eq "send") { cmd_send() } elsif ($cmd eq "recv") { cmd_recv() }
elsif ($cmd eq "place") { cmd_place() } elsif ($cmd eq "rename") { cmd_rename() }
else { bail("unknown command", 2) }
exit 0;
'''
AGENT_CMD = ("perl -e 'my $n = <STDIN>; defined $n or exit 2; read(STDIN, my $c, $n) == $n or exit 2; "
             "eval $c; die $@ if $@; exit 0'")


def agent_input(fields):
    code = AGENT_PL.encode()
    return str(len(code)).encode() + b"\n" + code + b"".join(encode_raw(f) + b"\0" for f in fields)


def agent_fail(rc, err, what):
    if rc == 127 or any("perl" in l and "not found" in l for l in err):
        fail("Copying, renaming and Replace on that machine need perl, which isn't installed there "
             "(macOS and most Linux systems include it)")
    fail(error_text(err, what), classify(err))


def run_agent(host, fields, timeout=600):
    """Run the agent for a short command; returns (rc, stdout bytes, stderr lines)."""
    try:
        proc = subprocess.run(["ssh"] + ssh_opts(host) + [host, AGENT_CMD], input=agent_input(fields),
                              capture_output=True, timeout=timeout, env=ENV)
    except subprocess.TimeoutExpired:
        return 124, b"", ["Timed out talking to " + host]
    return proc.returncode, proc.stdout, clean_stderr(proc.stderr.decode("utf-8", "replace"))


def start_agent(host, fields):
    errf = tempfile.TemporaryFile()
    proc = subprocess.Popen(["ssh"] + ssh_opts(host) + [host, AGENT_CMD], stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=errf, env=ENV, start_new_session=True)
    proc.errf = errf
    CHILDREN.append(proc)
    try:
        proc.stdin.write(agent_input(fields))
        proc.stdin.flush()
    except BrokenPipeError:
        finish_agent(proc, "Couldn't start the copy on " + host)
    return proc


def finish_agent(proc, what):
    try:
        proc.stdin.close()
    except OSError:
        pass
    rc = proc.wait()
    proc.errf.seek(0)
    err = clean_stderr(proc.errf.read().decode("utf-8", "replace"))
    if rc != 0:
        agent_fail(rc, err, what)
    return rc


class Reader:
    def __init__(self, f):
        self.f = f
        self.buf = b""

    def more(self):
        data = self.f.read1(262144)
        if not data:
            raise EOFError
        self.buf += data

    def exact(self, n):
        while len(self.buf) < n:
            self.more()
        data, self.buf = self.buf[:n], self.buf[n:]
        return data

    def field(self):
        while b"\0" not in self.buf:
            self.more()
        data, _, self.buf = self.buf.partition(b"\0")
        return decode_raw(data)

    def chunks(self, n):
        while n > 0:
            if not self.buf:
                self.more()
            data, self.buf = self.buf[:n], self.buf[n:]
            n -= len(data)
            yield data


def check_rel(p, roots):
    parts = p.split("/")
    if parts[0] not in roots or any(x in ("", ".", "..") for x in parts) or CONTROL_RE.search(p):
        fail("Unexpected item in the copy: %r" % p)


def agent_records(host, parent, names, prog):
    proc = start_agent(host, ["send", parent, str(len(names))] + names)
    proc.stdin.close()
    r = Reader(proc.stdout)
    roots = set(names)
    try:
        if r.exact(1) != b"T":
            raise EOFError
        prog.total = int(r.field())
        while True:
            t = r.exact(1)
            if t == b"Z":
                break
            if t == b"S":
                yield ("S",)
                continue
            p = r.field()
            check_rel(p, roots)
            if t == b"D":
                yield ("D", p, int(r.field()) & 0o7777, int(r.field()))
            elif t == b"F":
                mode, mtime, size = int(r.field()) & 0o7777, int(r.field()), int(r.field())
                chunks = r.chunks(size)
                yield ("F", p, mode, mtime, size, chunks)
                for _ in chunks:  # whatever the writer didn't take
                    pass
            elif t == b"L":
                yield ("L", p, r.field())
            else:
                raise EOFError
    except (EOFError, ValueError):
        finish_agent(proc, "Couldn't read the items on " + host)
        fail("The copy from %s stopped unexpectedly" % host)
    finish_agent(proc, "Couldn't read the items on " + host)


class AgentSink:
    """Writes records into the new folder `stage` inside dst_dir on host."""

    def __init__(self, host, dst_dir, stage):
        self.host = host
        self.proc = start_agent(host, ["recv", dst_dir, stage])

    def send(self, data):
        try:
            self.proc.stdin.write(data)
        except BrokenPipeError:
            finish_agent(self.proc, "The copy to %s stopped" % self.host)
            fail("The copy to %s stopped unexpectedly" % self.host)

    def write(self, rec, prog):
        kind, p = rec[0], rec[1]
        f = lambda s: encode_raw(str(s)) + b"\0"
        if kind == "D":
            self.send(b"D" + f(p) + f(rec[2]) + f(rec[3]))
        elif kind == "F":
            self.send(b"F" + f(p) + f(rec[2]) + f(rec[3]) + f(rec[4]))
            name = p.rpartition("/")[2]
            for chunk in rec[5]:
                self.send(chunk)
                prog.add(len(chunk), name)
        elif kind == "L":
            self.send(b"L" + f(p) + f(rec[2]))

    def close(self):
        self.send(b"Z")
        try:
            self.proc.stdin.close()
        except BrokenPipeError:
            pass
        reply = self.proc.stdout.read()
        finish_agent(self.proc, "Couldn't finish the copy on " + self.host)
        if reply != b"ok\0":
            fail("The copy to %s didn't finish" % self.host)


def agent_place(host, dst_dir, stage, replace):
    rc, stdout, err = run_agent(host, ["place", dst_dir, stage, "replace" if replace else "keep"])
    if rc != 0:
        agent_fail(rc, err, "Couldn't move the copied items into " + dst_dir)
    conflicts, errors = [], []
    i = 0
    while i < len(stdout) and stdout[i:i + 1] != b"Z":
        kind = stdout[i:i + 1]
        j = stdout.index(b"\0", i + 1)
        name = decode_raw(stdout[i + 1:j])
        (conflicts if kind == b"C" else errors).append(name if kind == b"C" else (name, ""))
        i = j + 1
    return conflicts, errors


# ----------------------------------------------------------------- Windows

def windows_home_only(host, folder):
    """SFTP can't hold a folder open or rename without a chance of replacing
    something, and a Windows machine has no shell to do it for us. So on
    Windows, copies only read from and write into folders inside the
    account's own home folder, which by default only that account (and
    administrators) can change. `folder` is checked as the server resolves
    it."""
    home = sftp_home(host)
    segs = sftp_batch(host, ["cd " + sftp_quote(folder), "pwd"], what=folder)
    real = pwd_value(segs[1])
    hk, rk = guard_key(home, True), guard_key(real, True)
    if not home or not (rk == hk or rk.startswith(hk.rstrip("/") + "/")):
        fail("On Windows, Tailnet Files only copies and renames inside your home folder (%s), where no other "
             "account can change things mid-way. %s is outside it." % (home or "unknown", real))


def is_windowsish(host):
    """Hosts reached only through SFTP (Windows). TAILFILES_ENGINE=sftp
    treats any host this way, for testing."""
    return not probe(host).get("posix") or os.environ.get("TAILFILES_ENGINE") in ("sftp", "scp")


STAGE_PREFIX = ".tailfiles-incoming-"
CLEANUP = []  # (target, folder) this copy created and removes when it ends


def new_relay():
    os.makedirs(CACHE_DIR, exist_ok=True)
    d = tempfile.mkdtemp(prefix="relay-", dir=CACHE_DIR)
    CLEANUP.append(("local", d))
    return d


def make_stage(target, dst_dir):
    """A new, empty folder inside dst_dir on a Windows machine."""
    path = join_remote(dst_dir, STAGE_PREFIX + os.urandom(8).hex())
    sftp_batch(check_host(target), ["mkdir " + sftp_quote(path)], what=dst_dir)
    CLEANUP.append((target, path))
    return path


def cleanup():
    """Remove the stage and relay folders. They hold only what this copy put
    there (after a successful copy, at most empty folders)."""
    global MUTED
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    MUTED = True
    # Let the helpers end first: one that sees its input end removes its
    # own unfinished folder, so nothing can appear after this cleanup.
    for p in CHILDREN:
        try:
            if p.stdin:
                p.stdin.close()
        except OSError:
            pass
    for p in CHILDREN:
        try:
            p.wait(timeout=20)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass
    while CLEANUP:
        target, path = CLEANUP.pop()
        try:
            if target == "local":
                shutil.rmtree(path)  # never follows symlinks
            elif probe(target).get("posix"):
                run_ssh(target, POSIX_DELETE_CMD, timeout=300, input_data=path + "\0")
            else:
                cmds = []
                sftp_walk_delete(target, path, cmds)
                run_sftp(target, cmds, timeout=300)
        except (OSError, SystemExit):
            pass


def lstat_kind(path):
    try:
        mode = os.lstat(path).st_mode
    except OSError:
        return None
    return "dir" if stat.S_ISDIR(mode) else "file" if stat.S_ISREG(mode) else "link" if stat.S_ISLNK(mode) else "other"


def remote_kinds(host, folder):
    """{name: dir|file|link|other} for a folder's entries, as the server
    lstat()s them (a link is reported as a link, not as its target)."""
    segs = sftp_batch(host, ["cd " + sftp_quote(folder), "pwd", "ls -lan"], what=folder)
    names = exact_names(host, pwd_value(segs[1])) if probe(host).get("posix") else None
    entries, skipped = sftp_entries(segs[2], names)
    if skipped:
        fail("Some names in %s can't be read safely, so nothing was copied there" % folder)
    return {e["name"]: {"-": "file", "d": "dir", "l": "link"}.get(e["perm"][0], "other") for e in entries}


def sftp_copy(host, verb, items, into):
    """get or put each (name, path) to into/name with sftp, which copies
    regular files and folders and skips symlinks and special files inside
    folders. Returns how many it skipped."""
    host = check_host(host)
    cmds = ["progress"]  # batch mode starts with the meter off
    for name, p in items:
        dest = (os.path.join(into, name) if verb == "get" else join_remote(into, name))
        cmds.append("%s -r -p %s %s" % (verb, sftp_quote(p), sftp_quote(dest)))
    fd, batch = tempfile.mkstemp(prefix="batch-", dir=RUNTIME if os.path.isdir(RUNTIME) else None)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(encode_raw("\n".join(cmds) + "\n"))
        rc, err = stream(["sftp"] + ssh_opts(host) + ["-b", batch, host], parse_scp)
    finally:
        os.unlink(batch)
    not_regular = [l for l in err if l.endswith("not a regular file")]
    if rc != 0:
        err = [l for l in err if l not in not_regular]
        fail(error_text(err, "Transfer failed (exit %d)" % rc), classify(err))
    return len(not_regular)


def move_remote_noreplace(host, stage, dst_dir, names):
    """Windows: move staged items into dst_dir with the plain SFTP rename,
    which refuses to replace. Returns the names still in the stage."""
    if not names:
        return []
    cmds = ["-rename -l %s %s" % (sftp_quote(join_remote(stage, n)), sftp_quote(join_remote(dst_dir, n)))
            for n in names]
    rc, _, err = run_sftp(host, cmds, timeout=300)
    if rc != 0:
        fail(error_text(err, "Couldn't move the copied items into " + dst_dir), classify(err))
    return existing_names(host, stage, names)


def plan_remote_merge(host, stage, dst_dir, items, cmds, conflicts):
    """Windows: queue renames that move staged items into dst_dir, merging
    folders. `items` are (name, local copy) pairs describing what was
    staged. A file replaces a file or link (the link itself); a folder
    merges only into a real folder."""
    have = remote_kinds(host, dst_dir)
    for name, lp in items:
        mine = lstat_kind(lp)
        if mine not in ("dir", "file"):
            continue  # sftp didn't copy it
        s, d = join_remote(stage, name), join_remote(dst_dir, name)
        theirs = have.get(name)
        if theirs is None:
            cmds.append("rename -l %s %s" % (sftp_quote(s), sftp_quote(d)))
        elif mine == "dir" and theirs == "dir":
            plan_remote_merge(host, s, d, [(c, os.path.join(lp, c)) for c in sorted(os.listdir(lp))],
                              cmds, conflicts)
        elif mine == "file" and theirs in ("file", "link"):
            cmds.append("rename %s %s" % (sftp_quote(s), sftp_quote(d)))
        else:
            conflicts.append(d)


# -------------------------------------------------------------------- copy

def exists_text(clash, folder, partial=False):
    shown = ", ".join(clash[:3]) + ("…" if len(clash) > 3 else "")
    return "%s already exist%s in %s%s" % (shown, "s" if len(clash) == 1 else "", folder,
                                            "; everything else was copied" if partial else "")


def cmd_copy(args):
    global COPYING
    COPYING = True  # from here on every failure is reported as a "done" event
    replace = bool(args) and args[0] == "--replace"
    if replace:
        args = args[1:]
    if len(args) < 4:
        fail("usage: copy [--replace] SRC_TARGET DST_TARGET DST_DIR PATH...")
    src, dst, dst_dir, paths = args[0], args[1], args[2], args[3:]
    for t in (src, dst):
        if t != "local":
            check_host(t)
    for p in paths + [dst_dir]:
        if CONTROL_RE.search(p):
            fail("%r contains a control character, so it can't be copied safely" % p)
    paths = [p.rstrip("/") or "/" for p in paths]
    names = [basename_of(p) for p in paths]
    if any(n in ("", ".", "..") for n in names) or len(set(names)) != len(names):
        fail("Each item to copy needs its own name")
    parents = {p.rpartition("/")[0] or "/" for p in paths}
    if len(parents) != 1:
        fail("The items to copy must all be in one folder")
    src_dir = parents.pop()
    if src == dst and any((dst_dir.rstrip("/") + "/").startswith(p + "/") for p in paths):
        fail("Can't copy a folder into itself")
    for host in [t for t in (src, dst) if t != "local"]:
        info = probe(host)
        if not info.get("ok"):
            fail(info.get("error", "Could not connect to " + host), info.get("kind", "other"))
    if src != "local" and is_windowsish(src):
        windows_home_only(src, src_dir)
    if dst != "local" and is_windowsish(dst):
        windows_home_only(dst, dst_dir)

    # Never overwrite without the user's say-so. Asking the filesystem
    # itself means a name that differs only in case counts on a
    # case-insensitive volume. This is only the early answer; placement
    # enforces it atomically.
    if not replace:
        clash = existing_names(dst, dst_dir, names)
        if clash:
            fail(exists_text(clash, dst_dir), "exists", names=clash)

    signal.signal(signal.SIGTERM, kill_child)
    signal.signal(signal.SIGINT, kill_child)
    out({"event": "start", "engine": "copy", "count": len(paths)})
    try:
        return run_copy(src, dst, src_dir, dst_dir, paths, names, replace)
    finally:
        cleanup()


def run_copy(src, dst, src_dir, dst_dir, paths, names, replace):
    prog = Progress()
    skipped = 0

    # Where the records come from.
    if src == "local":
        records = local_records(src_dir, names, prog)
    elif not is_windowsish(src):
        records = agent_records(src, src_dir, names, prog)
    else:
        # sftp skips symlinks inside folders; the selected items themselves
        # must be real files or folders (judged from the parent's listing).
        have = remote_kinds(src, src_dir)
        kept = [(n, p) for n, p in zip(names, paths) if have.get(n) in ("dir", "file")]
        skipped += len(paths) - len(kept)
        relay = new_relay()
        skipped += sftp_copy(src, "get", kept, relay)
        records = local_records(relay, [n for n, _ in kept], prog)

    # Where they go: a new folder only this copy writes into.
    stage = STAGE_PREFIX + os.urandom(8).hex()
    dst_win = dst != "local" and is_windowsish(dst)
    if dst == "local":
        dfd = open_top(dst_dir)
        try:
            os.mkdir(stage, 0o700, dir_fd=dfd)
        except OSError as e:
            fail("Can't write to %s (%s)" % (dst_dir, e.strerror), "denied" if e.errno == errno.EACCES else "other")
        CLEANUP.append(("local", os.path.join(dst_dir, stage)))
        sink = LocalSink(dfd, stage)
    elif not dst_win:
        CLEANUP.append((dst, join_remote(dst_dir, stage)))
        sink = AgentSink(dst, dst_dir, stage)
    else:
        relay_out = new_relay()
        rfd = open_top(relay_out)
        os.mkdir("items", 0o700, dir_fd=rfd)
        sink = LocalSink(rfd, "items")

    for rec in records:
        if rec[0] == "S":
            skipped += 1
        else:
            sink.write(rec, prog)
    sink.close()

    conflicts, errors = [], []
    if dst == "local":
        sfd = open_dir_at(dfd, stage)
        if sfd is None:
            fail("The copy's folder in %s changed, so nothing was moved into place" % dst_dir)
        place_local(sfd, dfd, "", replace, conflicts, errors)
    elif not dst_win:
        conflicts, errors = agent_place(dst, dst_dir, stage, replace)
    else:
        items_dir = os.path.join(relay_out, "items")
        tree = []
        for n in sorted(os.listdir(items_dir)):
            if lstat_kind(os.path.join(items_dir, n)) in ("dir", "file"):
                tree.append((n, os.path.join(items_dir, n)))
            else:
                skipped += 1  # sftp would follow a top-level link
        win_stage = make_stage(dst, dst_dir)
        skipped += sftp_copy(dst, "put", tree, win_stage)
        if not replace:
            left = move_remote_noreplace(check_host(dst), win_stage, dst_dir, [n for n, _ in tree])
            conflicts = existing_names(dst, dst_dir, left)
            errors = [(n, "") for n in left if n not in conflicts]
        else:
            cmds = []
            plan_remote_merge(check_host(dst), win_stage, dst_dir, tree, cmds, conflicts)
            rc, _, err = run_sftp(check_host(dst), cmds, timeout=300)
            if rc != 0:
                fail(error_text(err, "Couldn't move the copied items into " + dst_dir), classify(err))

    if errors:
        fail("Couldn't move %s into %s without a chance of replacing something (that disk can't rename "
             "atomically), so %s left out" % (", ".join(n for n, _ in errors[:3]), dst_dir,
                                               "it was" if len(errors) == 1 else "they were"))
    if conflicts:
        if replace:
            fail("Couldn't replace %s: a folder can only replace a folder, and a file a file or link"
                 % ", ".join(conflicts[:3]))
        fail(exists_text(conflicts, dst_dir, partial=len(conflicts) < len(names)), "exists", names=conflicts)
    out({"event": "done", "ok": True, "skipped": skipped})
    return 0


# ---------------------------------------------------------------- file ops

def guard_key(path, windows):
    """Comparable form of a path: Windows paths are case-insensitive, accept
    either slash and may be written /C:/x or C:/x."""
    p = path
    if windows:
        p = p.replace("\\", "/")
        if re.match(r"^[A-Za-z]:(/|$)", p):
            p = "/" + p
        p = p.lower()
    return p.rstrip("/") or "/"


def guard_delete(path, homes, windows=False):
    """Refuse anything but a plain absolute path that is not a root, a
    drive, a home folder of the machine it is on (as spelled and as
    resolved), or an ancestor of one. Without a known home nothing is
    deleted. Callers check both the path as given and its resolved form."""
    check_path(path)
    homes = {guard_key(h, windows) for h in homes if h}
    if not homes:
        fail("Refusing to delete: couldn't determine the home folder on that machine")
    norm = guard_key(path, windows)
    if not norm.startswith("/") \
            or any(p in (".", "..") for p in norm.split("/")) \
            or norm == "/" or re.match(r"^/[a-z]:$", norm, re.I) \
            or any(norm == h or h.startswith(norm + "/") for h in homes):
        fail("Refusing to delete " + path)


def cmd_mkdir(target, path):
    if target == "local":
        try:
            os.makedirs(path, exist_ok=False)
        except OSError as e:
            fail(str(e))
    else:
        rc, _, err = run_sftp(check_host(target), ["mkdir " + sftp_quote(path)])
        if rc != 0:
            fail(error_text(err, "Could not create folder"), classify(err))
    out({"ok": True})


def cmd_rename(target, old, new):
    check_path(old)
    check_path(new)
    old, new = old.rstrip("/") or "/", new.rstrip("/") or "/"
    (op, on), (np_, nn) = old.rpartition("/")[::2], new.rpartition("/")[::2]
    op, np_ = op or "/", np_ or "/"
    if op != np_ or on in ("", ".", "..") or nn in ("", ".", ".."):
        fail("Rename keeps an item in its folder")
    unsafe = "That disk can't rename without a chance of replacing something, so nothing was renamed"
    if target == "local":
        dfd = open_top(op)
        try:
            renameat2(dfd, on, dfd, nn, NOREPLACE)
        except OSError as e:
            if e.errno == errno.EEXIST:
                fail("Something named that already exists")
            fail(unsafe if can_not_be_atomic(e) else str(e.strerror))
        finally:
            os.close(dfd)
    elif not is_windowsish(check_host(target)):
        rc, _, err = run_agent(target, ["rename", op, on, nn], timeout=60)
        if rc == 17:
            fail("Something named that already exists")
        if rc == 22:
            fail(unsafe)
        if rc != 0:
            agent_fail(rc, err, "Could not rename")
    else:
        host = check_host(target)
        windows_home_only(host, op)
        if existing_names(target, op, [nn]):
            fail("Something named that already exists")
        # -l: the plain SFTP rename, which fails if the new name exists. The
        # default posix-rename extension would silently replace it.
        rc, _, err = run_sftp(host, ["rename -l " + sftp_quote(old) + " " + sftp_quote(new)])
        if rc != 0:
            fail(error_text(err, "Could not rename"), classify(err))
    out({"ok": True})


def remote_is_link(host, path):
    """True when `path` itself is a symlink (judged from its parent's listing,
    since `cd` would follow it)."""
    parent, _, name = path.rstrip("/").rpartition("/")
    segs = sftp_batch(host, ["cd " + sftp_quote(parent or "/"), "ls -lan"], what=parent or "/")
    for e in sftp_entries(segs[1])[0]:
        if e["name"] == name:
            return e["type"] == "link"
    fail("%s no longer exists" % path, "notfound")


def sftp_walk_delete(host, path, cmds, top=True):
    """Queue sftp commands deleting `path`. Nothing runs until every command
    is built, so an unrepresentable name anywhere aborts the whole delete."""
    if top and remote_is_link(host, path):
        cmds.append("rm " + sftp_quote(path))  # the link only, never its target
        return
    batch = ["cd " + sftp_quote(path), "pwd", "ls -lan"]
    rc, stdout, err = run_sftp(host, batch)
    if rc != 0:
        cmds.append("rm " + sftp_quote(path))  # not a folder
        return
    segs = sftp_segments(stdout, batch)
    if segs is None or len(segs) != len(batch):
        fail("The listing of %s didn't have the expected shape, so nothing was deleted" % path)
    entries, _ = sftp_entries(segs[2])
    for e in entries:
        child_path = join_remote(path, e["name"])
        if e["type"] == "dir":
            sftp_walk_delete(host, child_path, cmds, top=False)
        else:
            cmds.append("rm " + sftp_quote(child_path))
    cmds.append("rmdir " + sftp_quote(path))


# Deletes on POSIX machines run this fixed script; the paths arrive
# NUL-separated on stdin (xargs -0), so no shell ever parses them. For each
# path it enters the parent folder physically (cd -P), re-checks the real
# location against the account's own resolved home and its ancestors, and
# removes the item relative to the folder it is now in. Nothing can redirect
# the delete between that check and the rm, and the item's own name is never
# followed (a symlink is removed itself). `real` keeps names that end in a
# line break intact, which $(...) alone would trim.
POSIX_DELETE_SCRIPT = (
    'nl=$(printf "\\nx"); nl=${nl%x}; '
    'real() { r=$(pwd -P && echo .) || return 1; r=${r%.}; r=${r%"$nl"}; }; '
    'cd -P -- "$HOME" && real || { echo "cannot resolve the home folder" >&2; exit 3; }; H=$r; st=0; '
    'for p do '
    'case $p in /*) ;; *) echo "not absolute: $p" >&2; st=4; continue;; esac; '
    'parent=${p%/*}; name=${p##*/}; [ -n "$parent" ] || parent=/; '
    'case $name in ""|.|..) echo "refusing: $p" >&2; st=4; continue;; esac; '
    'if cd -P -- "$parent" && real; then '
    'case $r in /) t=/$name;; *) t=$r/$name;; esac; '
    'case "$H/" in "$t"/*) echo "Refusing to delete $t" >&2; st=5; continue;; esac; '
    'rm -rf -- "./$name" || st=1; '
    'else st=1; fi; '
    'done; exit $st'
)
POSIX_DELETE_CMD = "xargs -0 sh -c '%s' sh" % POSIX_DELETE_SCRIPT


def resolve_remote_parents(host, paths):
    """Each path with its parent folder resolved by the server (sftp `cd`
    uses the server's realpath, following every symlink) and its own name
    kept: rm and the SFTP walk remove a link itself, never its target. The
    reply must have the exact expected shape, so a resolved folder whose
    name contains a line break fails the delete instead of being cut short."""
    cmds = []
    names = []
    for p in paths:
        parent, _, name = p.rstrip("/").rpartition("/")
        cmds += ["cd " + sftp_quote(parent or "/"), "pwd"]
        names.append(name)
    segs = sftp_batch(host, cmds, what="the folders to delete from")
    return [join_remote(pwd_value(segs[2 * k + 1]), names[k]) for k in range(len(paths))]


def cmd_delete(target, paths):
    # No trailing slash: `rm -rf link/` would act on the link's target.
    paths = [p.rstrip("/") or "/" for p in paths]
    if target == "local":
        # This computer only ever uses the Trash. If moving something there
        # fails, stop: never fall back to deleting it permanently.
        homes = [HOME, os.path.realpath(HOME)]
        resolved = []
        for p in paths:
            guard_delete(p, homes)
            # Resolve symlinks in the parent folders, not the item itself:
            # gio trash moves a link, never its target.
            parent, name = os.path.split(p)
            real = os.path.join(os.path.realpath(parent or "/"), name)
            guard_delete(real, homes)
            resolved.append(real)
        paths = resolved
        trash = shutil.which("gio")
        if not trash:
            fail("Can't move to the Trash: gio (glib2) is not installed. Nothing was deleted.")
        for i, p in enumerate(paths):
            proc = subprocess.run([trash, "trash", "--", p], capture_output=True, text=True,
                                  stdin=subprocess.DEVNULL)
            if proc.returncode != 0:
                why = (proc.stderr.strip().splitlines() or ["gio trash failed"])[-1]
                done = "" if i == 0 else " The %d before it went to the Trash." % i
                fail("Couldn't move %s to the Trash (%s). It was not deleted.%s"
                     % (os.path.basename(p) or p, why, done), trashed=i)
        out({"ok": True, "trashed": True})
        return
    host = check_host(target)
    info = probe(host, use_cache=False)  # fresh: the guard needs this machine's home
    if not info.get("ok"):
        fail(info.get("error", "Could not connect"), info.get("kind", "other"))
    windows = not info.get("posix")
    # The home as the shell reports it and as the server resolves it.
    homes = [info.get("home"), sftp_home(host)] + ([] if windows else [HOME])
    if not info.get("home"):
        homes = []  # fail closed: the probe must have found the home
    for p in paths:
        guard_delete(p, homes, windows)
    # Check, and then delete, the paths as the remote filesystem resolves
    # them, so a symlinked parent can't hide a home folder or an ancestor.
    paths = resolve_remote_parents(host, paths)
    for p in paths:
        guard_delete(p, homes, windows)
    if info.get("posix"):
        # The command is fixed; the paths travel NUL-separated on stdin, so
        # no shell (whatever the login shell is) ever parses or globs them.
        rc, _, err = run_ssh(host, POSIX_DELETE_CMD, timeout=300,
                             input_data="".join(p + "\0" for p in paths))
        if rc != 0:
            fail(error_text(err, "Delete failed"), classify(err))
    else:
        cmds = []
        for p in paths:
            sftp_walk_delete(host, p, cmds)
        rc, _, err = run_sftp(host, cmds, timeout=300)
        if rc != 0:
            fail(error_text(err, "Delete failed"), classify(err))
    out({"ok": True, "trashed": False})


def cmd_open(target, path):
    if target != "local":
        host = check_host(target)
        dest_dir = os.path.join(CACHE_DIR, "open", host)
        os.makedirs(dest_dir, exist_ok=True)
        name = basename_of(path) or "file"
        if name in (".", ".."):
            fail("Can't open " + path)
        dest = os.path.join(dest_dir, name)
        # A fresh copy each time (never into a stale folder of the same name).
        if os.path.isdir(dest) and not os.path.islink(dest):
            shutil.rmtree(dest)
        elif os.path.lexists(dest):
            os.remove(dest)
        cmd = ["scp", "-p"] + ssh_opts(host) + ["--", host + ":" + glob_escape(path), dest]
        proc = subprocess.run(cmd, capture_output=True, text=True, env=ENV, stdin=subprocess.DEVNULL, timeout=600)
        if proc.returncode != 0:
            err = clean_stderr(proc.stderr)
            fail(error_text(err, "Could not fetch file"), classify(err))
        # Downloaded files are opened by their default app, never run.
        for root_dir, _, files in (os.walk(dest) if os.path.isdir(dest) else [("", [], [dest])]):
            for f in files:
                fp = os.path.join(root_dir, f) if root_dir else f
                if not os.path.islink(fp):
                    os.chmod(fp, os.lstat(fp).st_mode & 0o666)
        path = dest
    subprocess.Popen(["xdg-open", path], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    out({"ok": True, "path": path})


# -------------------------------------------------------------------- peers

def cmd_peers():
    try:
        proc = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as e:
        fail("tailscale is not available: %s" % e, "unreachable")
    if proc.returncode != 0:
        fail((proc.stderr or "tailscale status failed").strip().splitlines()[-1], "unreachable")
    try:
        data = json.loads(proc.stdout)
    except ValueError:
        fail("Could not read tailscale status")
    magic = bool((data.get("CurrentTailnet") or {}).get("MagicDNSEnabled", True))
    config = load_config()["hosts"]
    peers = []
    for p in (data.get("Peer") or {}).values():
        ips = p.get("TailscaleIPs") or []
        dns = (p.get("DNSName") or "").rstrip(".")
        short = dns.split(".")[0] if dns else ""
        host = short if (magic and short) else (ips[0] if ips else "")
        if not host or not HOST_RE.match(host):
            continue
        os_name = p.get("OS") or ""
        if os_name in ("iOS", "android", "tvOS"):
            continue  # no SSH server to talk to
        entry = config.get(host) if isinstance(config.get(host), dict) else {}
        peers.append({
            "host": host, "name": p.get("HostName") or short or host, "dns": dns,
            "ip": ips[0] if ips else "", "os": os_name, "online": bool(p.get("Online")),
            "user": entry.get("user") or "",
            "tailscaleSsh": "https://tailscale.com/cap/ssh" in (p.get("CapMap") or {}) or bool(p.get("sshHostKeys")),
        })
    peers.sort(key=lambda x: (not x["online"], x["name"].lower()))
    self_node = data.get("Self") or {}
    out({"ok": True, "backend": data.get("BackendState"), "self": self_node.get("HostName") or "",
         "user": os.environ.get("USER", ""), "last": load_config().get("last", ""), "peers": peers})


def peer_os(host):
    """The OS Tailscale reports for a host, lowercased, or "" if unknown."""
    try:
        proc = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=10)
        data = json.loads(proc.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return ""
    for p in (data.get("Peer") or {}).values():
        dns = (p.get("DNSName") or "").rstrip(".")
        if host in (dns.split(".")[0], dns, p.get("HostName"), *(p.get("TailscaleIPs") or [])):
            return (p.get("OS") or "").lower()
    return ""


# Windows OpenSSH reads administrators' keys from ProgramData, not the user's
# profile, and only if that file is locked down to Administrators and SYSTEM.
WINDOWS_ADD_KEY = r"""
$ErrorActionPreference = 'Stop'
$key = '__KEY__'
function Add-Key($file) {
  $dir = Split-Path $file
  if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
  if ((Test-Path $file) -and (Select-String -Path $file -SimpleMatch $key -Quiet)) { return 'already there' }
  Add-Content -Path $file -Value $key -Encoding ascii
  return 'added'
}
$r = Add-Key (Join-Path $env:USERPROFILE '.ssh\authorized_keys')
Write-Output ('User key file: ' + $r)
$admin = [Security.Principal.WindowsIdentity]::GetCurrent().Groups | Where-Object { $_.Value -eq 'S-1-5-32-544' }
if ($admin) {
  $f = Join-Path $env:ProgramData 'ssh\administrators_authorized_keys'
  $r = Add-Key $f
  icacls.exe $f /inheritance:r /grant '*S-1-5-32-544:F' /grant '*S-1-5-18:F' | Out-Null
  Write-Output ('Administrator key file: ' + $r)
}
"""


def cmd_setup_key(host):
    host = check_host(host)
    user = account(host)
    ssh_dir = os.path.join(HOME, ".ssh")
    pub = next((os.path.join(ssh_dir, k) for k in ("id_ed25519.pub", "id_ecdsa.pub", "id_rsa.pub")
                if os.path.exists(os.path.join(ssh_dir, k))), None)
    if not pub:
        os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
        key = os.path.join(ssh_dir, "id_ed25519")
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-f", key, "-N", ""], check=False,
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
        pub = key + ".pub"
    try:
        with open(pub) as fh:
            pubkey = fh.read().strip()
    except OSError:
        fail("Could not read your public key " + pub)

    who = user + "@" + host
    target = shlex.quote(who)
    lines = ["echo 'Setting up SSH key sign-in to %s'" % who, "echo",
             "echo 'You will be asked for the password of %s on %s once.'" % (user, host), "echo"]
    if peer_os(host) == "windows":
        ps = WINDOWS_ADD_KEY.replace("__KEY__", pubkey.replace("'", "''"))
        encoded = base64.b64encode(ps.encode("utf-16-le")).decode()
        remote = "powershell -NoProfile -NonInteractive -EncodedCommand " + encoded
        lines.append("ssh -o StrictHostKeyChecking=accept-new %s %s" % (target, shlex.quote(remote)))
    else:
        lines.append("ssh-copy-id -i %s -o StrictHostKeyChecking=accept-new %s" % (shlex.quote(pub), target))
    # Prove it worked rather than trusting the installer's own report.
    lines += [
        "echo",
        "if ssh -o BatchMode=yes -o ConnectTimeout=8 %s exit 2>/dev/null; then "
        "echo 'Key sign-in works. Press Retry in Tailnet Files.'; "
        "else echo 'Key sign-in still fails. Your public key is:'; cat %s; exit 1; fi"
        % (target, shlex.quote(pub)),
    ]
    script = "; ".join(lines)
    launcher = shutil.which("omarchy-launch-floating-terminal-with-presentation")
    if launcher:
        cmd = [launcher, "bash -c " + shlex.quote(script)]
    else:
        cmd = ["xdg-terminal-exec", "bash", "-c", script + "; read -p 'Press enter to close'"]
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    # The next probe must see the new key rather than a cached failure.
    try:
        forget_probe(host)
    except OSError:
        pass
    out({"ok": True})


# --------------------------------------------------------------------- main

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    while len(argv) >= 2 and argv[0] == "--as":
        host, _, user = argv[1].partition("=")
        check_host(host)
        if not user or not USER_RE.match(user):
            fail("Invalid account for %s" % host)
        if PINNED_USERS.get(host, user) != user:
            # Every connection to a host uses one account, so a copy between
            # two accounts on the same machine can't be pinned both ways.
            fail("Both sides are on %s but signed in as different accounts (%s and %s). "
                 "Use the same account on both sides." % (host, PINNED_USERS[host], user), "account",
                 **({"event": "done"} if "copy" in argv else {}))
        PINNED_USERS[host] = user
        argv = argv[2:]
    if not argv:
        fail("No command")
    cmd, args = argv[0], argv[1:]
    if cmd == "peers":
        cmd_peers()
    elif cmd == "probe" and len(args) == 1:
        info = probe(check_host(args[0]), use_cache=False)
        out(info)
        return 0 if info.get("ok") else 1
    elif cmd == "ls" and len(args) in (1, 2):
        path = args[1] if len(args) == 2 else ""
        out(list_local(path) if args[0] == "local" else list_remote(check_host(args[0]), path))
    elif cmd == "copy":
        return cmd_copy(args)
    elif cmd == "mkdir" and len(args) == 2:
        cmd_mkdir(*args)
    elif cmd == "rename" and len(args) == 3:
        cmd_rename(*args)
    elif cmd == "delete" and len(args) >= 2:
        cmd_delete(args[0], args[1:])
    elif cmd == "open" and len(args) == 2:
        cmd_open(*args)
    elif cmd == "config":
        out(dict({"ok": True}, **load_config()))
    elif cmd == "set-user" and len(args) in (1, 2):
        host = check_host(args[0])
        user = args[1].strip() if len(args) == 2 else ""
        if user and not USER_RE.match(user):
            fail("Invalid user name")
        data = load_config()
        if user:
            data["hosts"][host] = dict(data["hosts"].get(host) or {}, user=user)
        else:
            data["hosts"].pop(host, None)
        save_config(data)
        try:
            forget_probe(host)
        except OSError:
            pass
        out({"ok": True})
    elif cmd == "remember" and len(args) == 1:
        data = load_config()
        data["last"] = check_host(args[0])
        save_config(data)
        out({"ok": True})
    elif cmd == "setup-key" and len(args) == 1:
        cmd_setup_key(args[0])
    else:
        fail("Unknown command: " + " ".join(argv))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]) or 0)
    except BrokenPipeError:  # whoever was reading went away
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)
